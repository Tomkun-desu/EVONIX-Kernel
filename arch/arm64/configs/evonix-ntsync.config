# EVONIX NTSync fragment (optional, dispatch only)
# Applied on top of evonix.config when the workflow runs with use_ntsync=true.
# Sources: WildKernels/kernel_patches common/ntsync/ntsync_base.patch
# (drivers/misc/ntsync.c + include/uapi/linux/ntsync.h) and
# common/ntsync/ntsync_compat_android15-6.6.patch (Kconfig + Makefile).
CONFIG_NTSYNC=y
