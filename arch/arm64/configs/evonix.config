# EVONIX Kernel Configuration -EVONIX-HOS-V3.5
# Base: android15-6.6-lts / Linux 6.6.142
# Device: Poco X7 Pro / rodin

# WiFi/BT vendor module compatibility
CONFIG_MODULE_ALLOW_BTF_MISMATCH=y
# CONFIG_MODULE_SIG_PROTECT is not set
# CONFIG_CFG80211 is not set

# EVONIX UFS I/O scheduler support
CONFIG_MQ_IOSCHED_KYBER=y

# EVONIX kernel release branding
CONFIG_LOCALVERSION=""
# CONFIG_LOCALVERSION_AUTO is not set

# EVONIX TCP BBRv3
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_CUBIC=y
# CONFIG_DEFAULT_CUBIC is not set

# EVONIX BBRv3 pacing qdisc
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_DEFAULT=y
# CONFIG_DEFAULT_PFIFO_FAST is not set

# EVONIX AutoFDO profile optimization
CONFIG_AUTOFDO_CLANG=y

# EVONIX KernelSU Next v3.3.0
CONFIG_KSU=y
# CONFIG_KSU_DEBUG is not set
# CONFIG_KSU_DISABLE_MANAGER is not set
# CONFIG_KSU_DISABLE_POLICY is not set

# EVONIX production full-enforcing SELinux
CONFIG_SECURITY_SELINUX=y
# CONFIG_SECURITY_SELINUX_DEVELOP is not set
# CONFIG_SECURITY_SELINUX_BOOTPARAM is not set

CONFIG_CRYPTO_HMAC=y
CONFIG_CRYPTO_SHA256=y
CONFIG_TCP_CONG_BBR=y
CONFIG_TCP_CONG_BBR3=y
CONFIG_DEFAULT_BBR=y
CONFIG_DEFAULT_TCP_CONG="bbr"
CONFIG_NET_SCH_FQ=y
CONFIG_DEFAULT_FQ=y
# CONFIG_ARM64_MTE is not set
# CONFIG_KASAN is not set
CONFIG_LTO=y
CONFIG_LTO_CLANG=y
CONFIG_LTO_CLANG_THIN=y
# CONFIG_LTO_NONE is not set
# CONFIG_LTO_CLANG_FULL is not set

# EVONIX Wild-port: extra TCP congestion algorithms (BBR stays default)
CONFIG_TCP_CONG_BIC=y
CONFIG_TCP_CONG_WESTWOOD=y
CONFIG_TCP_CONG_HTCP=y

# EVONIX Wild-port: TTL/HL target + match (Wild networking-config)
CONFIG_NETFILTER_XT_TARGET_HL=y
CONFIG_IP_NF_TARGET_TTL=y
CONFIG_IP6_NF_TARGET_HL=y
CONFIG_NETFILTER_XT_MATCH_HL=y
CONFIG_IP6_NF_MATCH_HL=y

# EVONIX Wild-port: tmpfs xattr/ACL
CONFIG_TMPFS_XATTR=y
CONFIG_TMPFS_POSIX_ACL=y

# EVONIX Wild-port: full IPSet + Wild companions (Wild networking-config)
CONFIG_IP_SET=y
CONFIG_IP_SET_MAX=65534
CONFIG_IP_SET_BITMAP_IP=y
CONFIG_IP_SET_BITMAP_IPMAC=y
CONFIG_IP_SET_BITMAP_PORT=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_IPMARK=y
CONFIG_IP_SET_HASH_IPPORT=y
CONFIG_IP_SET_HASH_IPPORTIP=y
CONFIG_IP_SET_HASH_IPPORTNET=y
CONFIG_IP_SET_HASH_IPMAC=y
CONFIG_IP_SET_HASH_MAC=y
CONFIG_IP_SET_HASH_NETPORTNET=y
CONFIG_IP_SET_HASH_NET=y
CONFIG_IP_SET_HASH_NETNET=y
CONFIG_IP_SET_HASH_NETPORT=y
CONFIG_IP_SET_HASH_NETIFACE=y
CONFIG_IP_SET_LIST_SET=y
CONFIG_NETFILTER_XT_SET=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_NETFILTER_XT_MATCH_RECENT=y
CONFIG_NET_ACT_CONNMARK=y
CONFIG_NF_CONNTRACK_MARK=y
CONFIG_NF_NAT=y

# EVONIX Wild-port: IPv6 NAT (Wild networking-config)
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y

# EVONIX Wild-port: CIFS builtin (Wild cifs action uses =y; =m would need
# modules.bzl registration + a dist/copy step the workflow lacks, and GKI
# trim_nonlisted_kmi drops unlisted out-of-tree symbols)
CONFIG_NETWORK_FILESYSTEMS=y
CONFIG_NETFS_SUPPORT=y
CONFIG_KEYS=y
CONFIG_CIFS=y
CONFIG_CIFS_XATTR=y
CONFIG_CIFS_POSIX=y
